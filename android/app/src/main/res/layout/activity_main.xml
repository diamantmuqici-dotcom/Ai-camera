<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ink"
        app:scaleType="fillCenter" />

    <com.diamantmuqici.claritycam.DetectionOverlay
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Live scan guide and recognized text boxes" />

    <View
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:background="@drawable/preview_scrim" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLARITY / V2"
                android:textColor="@color/mint"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />
            <TextView
                android:id="@+id/cameraState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STARTING CAMERA"
                android:textColor="@color/muted"
                android:textSize="10sp"
                android:letterSpacing="0.1" />
        </LinearLayout>
        <TextView
            android:id="@+id/fpsBadge"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/pill_idle"
            android:gravity="center"
            android:minWidth="65dp"
            android:paddingHorizontal="8dp"
            android:text="— FPS"
            android:textColor="@color/pale"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/settingsTop"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/pill_idle"
            android:contentDescription="Image and camera settings"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="TUNE"
            android:textColor="@color/pale"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="82dp"
        android:background="@drawable/pill_idle"
        android:gravity="center"
        android:maxWidth="330dp"
        android:paddingHorizontal="15dp"
        android:paddingVertical="8dp"
        android:text="Scanning locally • frame a plate or text"
        android:textColor="@color/pale"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/errorCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="30dp"
        android:background="@drawable/error_card"
        android:elevation="16dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NO LIVE CAMERA"
            android:textColor="@color/mint"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />
        <TextView
            android:id="@+id/errorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Camera needs attention"
            android:textColor="@color/pale"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/errorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Check permission and try again."
            android:textColor="@color/muted"
            android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:text="RETRY CAMERA" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/control_panel"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="14dp"
        android:paddingEnd="17dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/plateMode"
                style="@style/ScanToggle"
                android:text="PLATES" />
            <TextView
                android:id="@+id/textMode"
                style="@style/ScanToggle"
                android:layout_marginStart="7dp"
                android:text="TEXT" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/autoSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="AUTO"
                android:textColor="@color/pale"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/scanResult"
            android:layout_width="match_parent"
            android:layout_height="39dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/pill_idle"
            android:contentDescription="Recognized candidate; tap to copy"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingHorizontal="13dp"
            android:text="FRAME A PLATE  /  TAP TEXT TO COPY"
            android:textColor="@color/pale"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView android:id="@+id/zoom05" style="@style/ZoomChip" android:text="0.5×" />
            <TextView android:id="@+id/zoom1" style="@style/ZoomChip" android:layout_marginStart="5dp" android:text="1×" />
            <TextView android:id="@+id/zoom2" style="@style/ZoomChip" android:layout_marginStart="5dp" android:text="2×" />
            <TextView android:id="@+id/zoom4" style="@style/ZoomChip" android:layout_marginStart="5dp" android:text="4×" />
            <TextView android:id="@+id/zoom8" style="@style/ZoomChip" android:layout_marginStart="5dp" android:text="8×" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/zoomSeek"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="4dp"
            android:contentDescription="Camera zoom"
            android:max="700"
            android:progress="0"
            android:progressTint="@color/mint"
            android:thumbTint="@color/mint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/galleryButton" style="@style/SideButton" android:text="FILES" />
            <TextView android:id="@+id/flipButton" style="@style/SideButton" android:layout_marginStart="6dp" android:text="FLIP" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <FrameLayout
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/shutter_ring">
                <View
                    android:id="@+id/shutterButton"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:background="@drawable/shutter_inner"
                    android:clickable="true"
                    android:contentDescription="Take photo"
                    android:focusable="true" />
            </FrameLayout>
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView android:id="@+id/torchButton" style="@style/SideButton" android:layout_marginEnd="6dp" android:text="LIGHT" />
            <TextView android:id="@+id/tuneButton" style="@style/SideButton" android:text="TUNE" />
        </LinearLayout>
        <TextView
            android:id="@+id/footerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="ON-DEVICE SCAN   •   NO UPLOADS"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:letterSpacing="0.1" />
    </LinearLayout>
</FrameLayout>
